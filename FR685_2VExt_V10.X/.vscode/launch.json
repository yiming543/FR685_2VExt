      "type": "mplab-core-da",
      "request": "launch",
      "project": "F150_RX_V01",
      "configuration": "default",
      "noDebug": true,
      "preLaunchTask": "F150_RX_V01: default - 建置 (Production)",
      "program": "${workspaceFolder}/out/F150_RX_V01/production/default-production.hex"
    }
  ]
